# GrabvoPrintPing configuration — copy to .env and adjust.

# Port the HTTP bridge listens on. The web app's "Print Agent URL"
# must point at this (e.g. http://192.168.1.50:8765).
PORT=8765

# Bind address. 0.0.0.0 lets other devices on the LAN (phones) reach
# this agent. Use 127.0.0.1 to restrict it to this machine only.
HOST=0.0.0.0

# Where the agent gets QZ Tray's digital certificate and signs print
# requests — the SAME two endpoints the Grabvo-Qz browser app already
# calls (/digital-certificate.txt and /sign-message). The private key
# never leaves that server and is never stored on this agent.
SIGNING_BASE_URL=https://qz.grabvo.app

# Origin(s) allowed to POST to this agent's HTTP API. "*" is fine for
# a trusted LAN; set it to your app's exact origin to lock it down
# (e.g. https://qz.grabvo.app).
ALLOWED_ORIGIN=*

# --- Self-update (source-based, no GitHub Releases / no .exe) ---
UPDATE_REPO_OWNER=maiz-an
UPDATE_REPO_NAME=Grabvo-P2
UPDATE_BRANCH=main
# Set to "false" to disable automatic self-update checks entirely.
AUTO_UPDATE=true
# How often to check version.txt on GitHub, in minutes.
UPDATE_CHECK_INTERVAL_MINUTES=360
